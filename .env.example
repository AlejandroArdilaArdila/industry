APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

# Cuando está en false, este proyecto solo expone las rutas api (igual que bkAPiPos).
PANEL_ENABLED=false

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
# Carpeta raíz de documentos de Dolibarr (equivalente a DOL_DATA_ROOT), usada para servir
# var/www/STIO/documents/
DOL_DOCUMENTS_ROOT="/var/www/api-e.integros365.com/documents/"
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# Debe ser igual a $dolibarr_main_instance_unique_id de conf.php en Dolibarr,
# se usa para validar el header DOLAPIKEY contra user.api_key.
DOLIBARR_INSTANCE_KEY=

VITE_APP_NAME="${APP_NAME}"

DOLIBARR_INSTANCE_KEY=90e8bda5655c94479f6b915f38672ad9

# URL del logo de la empresa mostrado en el login del panel.
COMPANY_LOGO_URL=

# Licencia de Syncfusion (Essential JS 2, línea 34.x). Necesita el prefijo
# VITE_ para que Vite la exponga al bundle del navegador.
VITE_SYNCFUSION_LICENSE_KEY=
